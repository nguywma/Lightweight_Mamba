<launch>
  <arg name="weights_file" default="/home/manh/HE-Nav/src/perception_henav/LBSCNet/weights/weights_epoch_065.pth" />
  <arg name="dataset_root" default="/home/manh/HE-Nav/src/navigation/plan_manage/raw_data/voxels" />
  <arg name="output_path" default="/home/manh/HE-Nav/src/perception_henav/LBSCNet/prediction" />

  <node name="inference_ros" pkg="perception_henav" type="inference_ros_lbscnet.py" output="screen">
    <param name="weights_file" value="$(arg weights_file)" />
    <param name="dataset_root" value="$(arg dataset_root)" />
    <param name="output_path" value="$(arg output_path)" />
  </node>
</launch>


