<launch>
    <arg name="map_size_x" value="200.0"/>
    <arg name="map_size_y" value="200.0"/>
    <arg name="map_size_z" value=" 10.0"/>
    <!-- false: stay alive after a /sequence/start mission and accept the next one -->
    <arg name="exit_on_finish" default="true"/>

    <include file="$(find ego_planner)/launch/include/run_in_sim.xml">
        <arg name="drone_id" value="0"/>
        <arg name="init_x" value="0.0"/>
        <arg name="init_y" value="0.0"/>
        <arg name="init_z" value="2.0"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="/mavros/local_position/odom"/>
        <arg name="depth_topic" value="/camera/depth/image_raw"/>
        <arg name="fx" value="461.0967712402344"/>
        <arg name="fy" value="461.0967712402344"/>
        <arg name="cx" value="424.0"/>
        <arg name="cy" value="240.0"/>
        <arg name="flight_type" value="3"/>
        <arg name="exit_on_finish" value="$(arg exit_on_finish)"/>
    </include>
</launch>
