<launch>
  <arg name="weights_file" default="/home/manh/HE-Nav/src/perception/LBSCNet/weights/weights_epoch_071.pth" /> 
  <arg name="dataset_root" default="/home/manh/HE-Nav/src/navigation/plan_manage/raw_data/voxels" />
  <arg name="output_path" default="/home/manh/HE-Nav/src/perception/LBSCNet/prediction" />
  <arg name="conf_threshold" default="0.6" />

  <node name="inference_ros" pkg="perception" type="inference_ros_lbscnet.py" output="screen">
    <param name="weights_file" value="$(arg weights_file)" />
    <param name="dataset_root" value="$(arg dataset_root)" />
    <param name="output_path" value="$(arg output_path)" />
    <param name="conf_threshold" value="$(arg conf_threshold)" />
  </node>
</launch>


